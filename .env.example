# Copy to .env. Never commit the populated file.
LIFEOS_MODE=demo
LIFEOS_ENVIRONMENT=development
LIFEOS_PUBLIC_DEMO=false
LIFEOS_DATABASE_URL=sqlite:///./data/lifeos.db
LIFEOS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000","http://localhost:8010","http://127.0.0.1:8010"]
# Required for live login (minimum 16 characters) and production token encryption.
LIFEOS_AUTH_PASSWORD=
LIFEOS_ENCRYPTION_KEY=
LIFEOS_OPENAI_API_KEY=
LIFEOS_OPENAI_MODEL=gpt-4.1-mini
LIFEOS_GOOGLE_CLIENT_ID=
LIFEOS_GOOGLE_CLIENT_SECRET=
LIFEOS_GOOGLE_REDIRECT_URI=http://localhost:8010/api/integrations/google/callback
LIFEOS_DISCORD_BOT_TOKEN=
LIFEOS_DISCORD_CHANNEL_ID=
LIFEOS_GOOGLE_MAPS_API_KEY=
LIFEOS_MAPS_ORIGIN=
LIFEOS_MAPS_DESTINATION=
# Optional exact Google Docs or text file ID for proposal context.
LIFEOS_DRIVE_PROPOSAL_FILE_ID=
LIFEOS_WHATSAPP_ENABLED=false
# Set false only for a local desktop runtime with a visible browser.
LIFEOS_WHATSAPP_HEADLESS=true
LIFEOS_WHATSAPP_PROFILE_DIR=.private/whatsapp
LIFEOS_WHATSAPP_CONTACT=
# Compose requires this value; use a generated hex password, not this blank default.
POSTGRES_PASSWORD=
# Optional Compose host port when 8000 is already in use.
LIFEOS_PORT=8000
